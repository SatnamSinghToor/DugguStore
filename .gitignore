*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/app/build
*.apk
*.aab

# Release signing key — losing this or leaking it is a one-way door
# (Play App Signing can reset a lost upload key, but a leaked one lets
# someone else sign updates to your app). Never commit it.
*.jks
*.keystore
/keystore/

# ...except the debug keystore, which is deliberately shared (see the
# comment on its signingConfig in app/build.gradle.kts) so every debug
# build, on any machine or CI runner, carries the same signature and
# installs over the last one instead of demanding an uninstall first.
!app/debug.keystore

# Environment variables — never commit secrets
.env.local
.env*.local
