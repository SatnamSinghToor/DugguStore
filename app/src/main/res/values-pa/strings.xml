    <!-- Register: terms acknowledgement -->
    <string name="auth_terms_prefix">ਮੈਂ ਸਹਿਮਤ ਹਾਂ</string>
    <string name="auth_terms_link">ਨਿਯਮ ਅਤੇ ਗੋਪਨੀਯਤਾ ਨੀਤੀ ਨਾਲ</string>
    <string name="auth_err_terms">ਜਾਰੀ ਰੱਖਣ ਲਈ ਨਿਯਮ ਅਤੇ ਗੋਪਨੀਯਤਾ ਨੀਤੀ ਸਵੀਕਾਰ ਕਰੋ</string>
    <string name="auth_terms_dialog_body">Duggu Store ਵਰਤ ਕੇ ਤੁਸੀਂ ਜ਼ਿੰਮੇਵਾਰੀ ਨਾਲ ਆਰਡਰ ਕਰਨ ਅਤੇ ਸਹੀ ਡਿਲੀਵਰੀ ਵੇਰਵੇ ਦੇਣ ਲਈ ਸਹਿਮਤ ਹੁੰਦੇ ਹੋ। ਵਿਕਰੇਤਾ ਅਤੇ ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ, ਪਲੇਟਫਾਰਮ ਉੱਤੇ ਕੰਮ ਸ਼ੁਰੂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਤਸਦੀਕ ਕੀਤੇ ਜਾਂਦੇ ਹਨ।\n\nਅਸੀਂ ਤੁਹਾਡਾ ਨਾਂ, ਮੋਬਾਈਲ ਨੰਬਰ, ਪਤੇ ਅਤੇ ਆਰਡਰ ਇਤਿਹਾਸ ਤੁਹਾਡੇ ਆਰਡਰ ਪੂਰੇ ਕਰਨ ਲਈ ਰੱਖਦੇ ਹਾਂ, ਅਤੇ ਤੁਹਾਡਾ ਟਿਕਾਣਾ ਸਿਰਫ਼ ਆਰਡਰ ਦਿੰਦੇ ਸਮੇਂ, ਜਾਂ ਵਿਕਰੇਤਾਵਾਂ/ਡਿਲੀਵਰੀ ਪਾਰਟਨਰ ਲਈ ਪਿੱਕਅੱਪ ਅਤੇ ਡਿਲੀਵਰੀ ਰੂਟ ਕਰਨ ਲਈ ਵਰਤਦੇ ਹਾਂ। ਇਹ ਡਾਟਾ ਕਦੇ ਕਿਸੇ ਤੀਜੀ ਧਿਰ ਨੂੰ ਨਹੀਂ ਵੇਚਿਆ ਜਾਂਦਾ।</string>
    <string name="dialog_close">ਬੰਦ ਕਰੋ</string>

